<FinalDraft DocumentType="Script" Template="No" Version="5">
  <Content>
    <Paragraph Type="Scene Heading">
      <Text>INT. ROOM 1 - NIGHT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>LENA walks in. The room is </Text><Text Style="Italic">small</Text><Text> and dark.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LENA</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(whispering)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I can't believe you're here.</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>CUT TO:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <Text>EXT. ROOM 2 - DAY</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MAX</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We need to talk.</Text>
    </Paragraph>
  </Content>
  <TitlePage>
    <Content>
      <Paragraph Alignment="Center"><Text>The Harbor Light</Text></Paragraph>
